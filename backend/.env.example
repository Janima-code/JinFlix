# Copy to backend/.env and fill in your key from https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Comma-separated origins allowed to call this API.
# Unset (the default) allows only http://localhost:5173 and
# http://127.0.0.1:5173. A deployed frontend on another domain will be blocked
# by the browser until you set this, so on Render/Vercel/etc. set it to the
# frontend's origin, with no trailing slash and no path:
#   CORS_ORIGINS=https://jinflix.vercel.app,https://www.jinflix.vercel.app
CORS_ORIGINS=