# Copy to backend/.env and fill in your key from https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Comma-separated origins allowed to call this API. Only needed in production;
# the default already covers http://localhost:5173 and http://127.0.0.1:5173.
# CORS_ORIGINS=https://app.example.com,https://www.example.com